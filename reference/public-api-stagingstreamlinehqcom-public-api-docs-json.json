    "/v1/icons/{hash}/download/svg": {
      "get": {
        "description": "Apply the required modifications to the asset such as size as color and returns the SVG.",
        "operationId": "downloadIconAsSVG",
        "parameters": [
          {
            "name": "hash",
            "required": true,
            "in": "path",
            "description": "This is the icon ID, you can obtain the icon hash from a global search response",
            "schema": {
              "example": "ico_XjMYRy9v4t96OdUn",
              "type": "string"
            }
          },
          {
            "name": "colors",
            "required": false,
            "in": "query",
            "description": "Comma-separated list of HEX or CSS named colors to use when exporting the asset. Each color must be a valid HEX code (3–8 digits) or a standard CSS color name.",
            "schema": {
              "default": [],
              "example": "#000000, #CDFF71, red, blue",
              "type": "string"
            }
          },
          {
            "name": "backgroundColor",
            "required": false,
            "in": "query",
            "description": "Apply a filled color background to an image. The default color is transparent.",
            "schema": {
              "default": "#ffffff00",
              "example": "#ffffff00",
              "type": "string"
            }
          },
          {
            "name": "strokeWidth",
            "required": false,
            "in": "query",
            "description": "Allows increasing or decreasing the thickness of the vector paths.",
            "schema": {
              "example": 1.5,
              "type": "number"
            }
          },
          {
            "name": "size",
            "required": true,
            "in": "query",
            "description": "Image size in pixels (square): Enter one number — e.g., 100 = 100px × 100px.",
            "schema": {
              "minimum": 1,
              "maximum": 4096,
              "default": 48,
              "example": 48,
              "type": "number"
            }
          },
          {
            "name": "responsive",
            "required": true,
            "in": "query",
            "description": "Generates an SVG that scales with its container using viewBox and no fixed size. If true, width and height attributes will be removed from the SVG tag.",
            "schema": {
              "default": false,
              "type": "boolean"
            }
          },
          {
            "name": "strokeToFill",
            "in": "query",
            "required": false,
            "description": "When true, SVG strokes will be converted to fills.",
            "schema": {
              "type": "boolean",
              "default": ""
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully returns the icon as an SVG image.",
            "content": {
              "image/svg+xml": {
                "example": "<svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"#000000\" aria-hidden=\"true\" id=\"Home--Streamline-Heroicons-Outline\">\n        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"m2.25 12 8.954 -8.955c0.44 -0.439 1.152 -0.439 1.591 0L21.75 12M4.5 9.75v10.125c0 0.621 0.504 1.125 1.125 1.125H9.75v-4.875c0 -0.621 0.504 -1.125 1.125 -1.125h2.25c0.621 0 1.125 0.504 1.125 1.125V21h4.125c0.621 0 1.125 -0.504 1.125 -1.125V9.75M8.25 21h8.25\" stroke-width=\"1\"></path>\n      </svg>"
              }
            }
          },
          "400": {
            "description": "A Bad Request is returned when required fields are missing or when an invalid value is provided.",
            "content": {
              "application/json": {
                "example": {
                  "message": "Required fields are missing or invalid",
                  "error": "Bad Request",
                  "statusCode": 400
                }
              }
            }
          },
          "401": {
            "description": "An Unauthorized response is returned when the api key is not passed or is not valid.",
            "content": {
              "application/json": {
                "example": {
                  "message": "Api key is required",
                  "error": "Unauthorized",
                  "statusCode": 401
                }
              }
            }
          },
          "403": {
            "description": "A Forbidden response is returned when a user attempts to access a resource they don’t have permission for.",
            "content": {
              "application/json": {
                "example": {
                  "message": "'You don't have access to this resource.'",
                  "error": "Forbidden Request",
                  "statusCode": 403
                }
              }
            }
          },
          "404": {
            "description": "A Not Found response is returned when a user requests a resource that does not exist.",
            "content": {
              "application/json": {
                "example": {
                  "message": "Resource not found",
                  "error": "Not Found",
                  "statusCode": 404
                }
              }
            }
          }
        },
        "security": [
          {
            "api-key": []
          }
        ],
        "summary": "Download icon as SVG.",
        "tags": [
          "Icons"
        ]
      }
    },
